<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test for the Contain engines — the blocking/safety path
       (firewall rule builders, the blocks store, telemetry rule catalog and
       evaluation). Built TEST-FIRST, before the phase 3 extraction, and it
       proved all 28 checks at the source; after the move it references
       core\AutoCommand.Contain.Core and runs the shipped assembly (the
       phase 1/2 pattern — stronger than byte-identical source copies).
       Everything is synthetic/offline: temp dirs for the blocks store, a
       synthetic rules catalog, pure rule-name builders. The live halves
       (netsh, COM policy, Defender, update freeze) are exercised by the app
       itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ContainSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engines\Engines.Watch\Engines.Watch.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\AutoCommand.Contain.Core\AutoCommand.Contain.Core.csproj" />
    <ProjectReference Include="..\Engines\Engines.Firewall\Engines.Firewall.fsproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Engine types under their autocommand-ii names (F# port renamed
         FirewallRuleItem -> RuleInfo) -->
    <Using Include="FirewallRuleItem = AutoCommand.Engines.Firewall.RuleInfo" />
    <Using Include="BlockedTarget = AutoCommand.Engines.Firewall.BlockedTarget" />
    <Using Include="GroupToggleResult = AutoCommand.Engines.Firewall.GroupToggleResult" />
    <Using Include="FleetToggleResult = AutoCommand.Engines.Firewall.FleetToggleResult" />
    <Using Include="FirewallLogHit = AutoCommand.Engines.Firewall.FirewallLogHit" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="AutoCommand.Engines.Watch" />
  </ItemGroup>
</Project>
