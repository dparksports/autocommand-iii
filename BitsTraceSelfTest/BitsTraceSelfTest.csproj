<Project Sdk="Microsoft.NET.Sdk">


  <!-- Offline self-test for the BITS Transfers tab's engine: compiles the
       services/models from the app project directly, so what runs here is
       byte-identical to what ships in AutoCommand. Excluded from the app
       build (AutoCommand.csproj Compile Remove, like TaskAttributionSelfTest):
       it has its own Main() and would double-define the linked classes.
       Everything is synthetic/offline — no COM, no DNS, no event log, and
       persistence is redirected to a temp dir. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BitsTraceSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engines\Engines.Watch\Engines.Watch.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- All engines now from the Forensics core library (phase 4
         extraction, REWRITE.md) — this harness exercises the shipped
         assembly; no source copies remain here. -->
    <ProjectReference Include="..\core\AutoCommand.Forensics.Core\AutoCommand.Forensics.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AutoCommand.Engines.Watch" />
  </ItemGroup>
</Project>
