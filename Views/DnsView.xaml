<UserControl x:Class="AutoCommand.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + filters -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <ComboBox x:Name="FacetCombo" Width="130" FontSize="11" Margin="0,0,8,0"
                          SelectionChanged="FacetCombo_SelectionChanged" SelectedIndex="0"
                          ToolTip="Group the feed by domain (who asks for it) or by process (what it resolves)">
                    <ComboBoxItem Content="By domain"/>
                    <ComboBoxItem Content="By process"/>
                </ComboBox>
                <TextBox x:Name="ContainsBox" Width="180" FontSize="11" Margin="0,0,8,0"
                         KeyDown="ContainsBox_KeyDown"
                         ToolTip="Filter: domain or process contains this text"/>
                <ComboBox x:Name="MinutesCombo" Width="110" FontSize="11" Margin="0,0,8,0"
                          SelectionChanged="MinutesCombo_SelectionChanged" SelectedIndex="1"
                          ToolTip="Look-back window">
                    <ComboBoxItem Content="Last 60 min"/>
                    <ComboBoxItem Content="Last 6 h"/>
                    <ComboBoxItem Content="Last 24 h"/>
                </ComboBox>
                <Button x:Name="RefreshBtn" Content="⟳ Refresh" Click="RefreshBtn_Click" Padding="10,4" FontSize="11"/>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🌐 DNS Queries" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Every hostname this machine resolves (Sysmon EID 22) — who asks, how regularly, and what came back."
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Status -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="Loading the query feed…"/>
        </Border>

        <!-- Domain facet -->
        <DataGrid x:Name="DomainGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                  FontSize="11" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center"
                                       ToolTip="{Binding GlyphToolTip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="250"
                                    FontFamily="Consolas" IsReadOnly="True"/>
                <DataGridTextColumn Header="Asked by" Binding="{Binding AskedBy}" Width="230"/>
                <DataGridTextColumn Header="Queries" Binding="{Binding Queries}" Width="70"/>
                <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen}" Width="120"/>
                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="120"/>
                <DataGridTextColumn Header="Regularity" Binding="{Binding Regularity}" Width="150"/>
                <DataGridTextColumn Header="Resolved (top)" Binding="{Binding Resolved}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Process facet -->
        <DataGrid x:Name="ProcessGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Visibility="Collapsed"
                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                  FontSize="11" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="220"
                                    FontFamily="Consolas" IsReadOnly="True"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                <DataGridTextColumn Header="Domains" Binding="{Binding Domains}" Width="90"/>
                <DataGridTextColumn Header="Queries" Binding="{Binding Queries}" Width="90"/>
                <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen}" Width="120"/>
                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="120"/>
                <DataGridTextColumn Header="Top domains" Binding="{Binding TopDomains}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
