<UserControl x:Class="AutoCommand.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Same brighter gray the Blocks tab carries for its dense body text. -->
        

        <!-- Severity accents at ~15% alpha for the badge fill. -->
        <SolidColorBrush x:Key="SevRoutineBg" Color="#2634D399"/>
        <SolidColorBrush x:Key="SevInfoBg" Color="#263B82F6"/>
        <SolidColorBrush x:Key="SevResolvedBg" Color="#26FBBF24"/>
        <SolidColorBrush x:Key="SevAttentionBg" Color="#26F87171"/>

        <!-- Left severity bar of an incident card. -->
        <Style x:Key="SevBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="info">
                    <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="resolved">
                    <Setter Property="Background" Value="{DynamicResource AccentAmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="attention">
                    <Setter Property="Background" Value="{DynamicResource AccentRedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Badge fill + text per severity. -->
        <Style x:Key="SevBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SevRoutineBg}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="info">
                    <Setter Property="Background" Value="{StaticResource SevInfoBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="resolved">
                    <Setter Property="Background" Value="{StaticResource SevResolvedBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="attention">
                    <Setter Property="Background" Value="{StaticResource SevAttentionBg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SevBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="info">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="resolved">
                    <Setter Property="Foreground" Value="{DynamicResource AccentAmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="attention">
                    <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One incident: colored bar · sentence + meta · badge · chevron.
             Expanding the chevron reveals the raw events and a deep link
             into the Blocks tab — the audit trail itself stays read-only. -->
        <DataTemplate x:Key="IncidentTemplate">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                    Margin="0,0,0,8" Padding="0">
                <StackPanel>
                    <DockPanel Margin="12,10,12,10">
                        <Border DockPanel.Dock="Left" Width="3" CornerRadius="2"
                                Margin="0,0,12,0" Style="{StaticResource SevBar}"/>
                        <ToggleButton DockPanel.Dock="Right" x:Name="Chev" IsChecked="False"
                                      Cursor="Hand" Focusable="False" Margin="10,0,0,0"
                                      ToolTip="Show the raw events behind this incident">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <TextBlock x:Name="Glyph" Text="▾" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" CenterX="6" CenterY="6"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Glyph" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" CenterX="6" CenterY="6"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border DockPanel.Dock="Right" Style="{StaticResource SevBadge}" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource SevBadgeText}" Text="{Binding Severity}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Sentence}" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Visibility="{Binding IsChecked, ElementName=Chev, Converter={StaticResource BoolToVis}}"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource BackgroundBrush}"
                            Margin="0,0,0,0" Padding="16,10,16,12">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding EventLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Margin="0,1,0,1"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Review in Blocks →" Click="ReviewInBlocks_Click"
                                    Margin="0,8,0,0" Padding="8,3" FontSize="11" HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    ToolTip="Open the Blocks tab to act on these targets (re-enable, remove, pause)."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Day group header: TODAY · FRIDAY, OCT 30 -->
        <Style x:Key="DayGroupHeader" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,14,0,6" Padding="0,0,0,4"/>
                            <ItemsPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + actions -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="ExportBtn" Content="⇩ Export CSV" Click="ExportBtn_Click"
                        Padding="10,4" FontSize="11" Margin="0,0,8,0"
                        ToolTip="Export the events behind the current filter as CSV (house export format)."/>
                <CheckBox x:Name="LedgerCheck" Content="Raw ledger" FontSize="11"
                          VerticalAlignment="Center" Checked="LedgerCheck_Changed"
                          Unchecked="LedgerCheck_Changed"
                          ToolTip="One row per raw event, same facts as the story — for when you want the ledger."/>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🧾 Audit" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Every change to your blocks — yours, AutoCommand's, or anything else on this PC — in plain language. Nothing is deleted from this trail."
                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Reassurance first: the only question a returning user has -->
        <Border x:Name="StatusStrip" Grid.Row="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock x:Name="StatusIcon" DockPanel.Dock="Left" Text="✓" FontSize="13"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusWhen" DockPanel.Dock="Right" FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusMain" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusSub" FontSize="12" Margin="6,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filters: defaults match attention span, not completeness -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="TimeCombo" MinWidth="130" FontSize="11" SelectionChanged="Filter_Changed"
                          ToolTip="How far back to look. 'Since last visit' mirrors the digest toast."/>
                <ComboBox x:Name="CatCombo" MinWidth="120" FontSize="11" Margin="8,0,0,0"
                          SelectionChanged="Filter_Changed"/>
            </StackPanel>
        </DockPanel>

        <!-- Story (default) / ledger -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IncidentsList" ItemTemplate="{StaticResource IncidentTemplate}"
                              HorizontalContentAlignment="Stretch" Margin="0,0,8,0">
                    <ItemsControl.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource DayGroupHeader}"/>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>
            <DataGrid x:Name="LedgerGrid" Visibility="Collapsed" IsReadOnly="True"
                      AutoGenerateColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" FontSize="12"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                    <DataGridTextColumn Header="What happened" Binding="{Binding What}" Width="*"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="220"/>
                    <DataGridTextColumn Header="By" Binding="{Binding By}" Width="170"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="Nothing matches these filters. Every change to your blocks will appear here in plain language."
                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
