<UserControl x:Class="AutoCommand.Views.BlocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + actions -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="RepairBtn" Content="🔎 Repair attribution" Click="RepairBtn_Click"
                        Padding="10,4" FontSize="11" Margin="0,0,8,0"
                        ToolTip="Recovers the real service behind each 'svchost' block from the 30-day Sysmon archive (network event → PID → command line → service)."
                       />
                <Button x:Name="RefreshBtn" Content="⟳ Refresh" Click="RefreshBtn_Click"
                        Padding="10,4" FontSize="11"
                        ToolTip="Reload block records and reconcile with the live firewall rules."
                       />
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="⛔ Blocks" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Every firewall block this app created — grouped by the Windows service that actually made the connection, not by 'svchost.exe'."
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- State ribbon (click a chip = filter) + bulk command bar.
             Commands always state their true scope: the count of targets
             that will change, never the whole-list total. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <CheckBox x:Name="SelectAllPausedChk" Content="Select all paused" FontSize="11" IsThreeState="True"
                          VerticalAlignment="Center" Margin="0,2,10,0"
                          Checked="SelectAllPaused_Changed" Unchecked="SelectAllPaused_Changed"
                          ToolTip="Check every paused block in the list below (the '⏸ Paused' chip shows only those). Clear to drop the selection."
                          Visibility="Collapsed"/>
                <Button x:Name="ResumeSelectedBtn" Click="ResumeSelectedBtn_Click" Margin="0,0,8,0"
                        Padding="10,3" FontSize="11" Visibility="Collapsed"
                        ToolTip="Opens the preview sheet for the checked paused blocks only."
                       />
                <Button x:Name="ResumePausedBtn" Click="ResumePausedBtn_Click" Margin="0,0,8,0"
                        Padding="10,3" FontSize="11"
                        ToolTip="Opens the preview sheet: every paused block, grouped by service, with a high-impact warning and an 'except high-impact' option."
                       />
                <Button x:Name="PauseActiveBtn" Click="PauseActiveBtn_Click"
                        Padding="10,3" FontSize="11"
                        ToolTip="Opens the preview sheet for every active block — e.g. before troubleshooting, pause everything at once."
                       />
            </StackPanel>
            <ListBox x:Name="FilterList" SelectionChanged="FilterList_SelectionChanged"
                     BorderThickness="0" Background="Transparent" FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chip" Background="{DynamicResource SurfaceBrush}" CornerRadius="3"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Padding="8,3" Margin="0,0,6,4" Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- Restore guide: a feature broke — which of my blocks is doing it? -->
        <Border x:Name="RestorePanel" Grid.Row="2" Margin="0,0,0,10"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentRedBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10,6" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="RestoreBanner" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Broken feature:" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="SymptomCombo" MinWidth="300" FontSize="11"
                              SelectionChanged="SymptomCombo_SelectionChanged"/>
                    <Button x:Name="PauseMatchedBtn" Click="PauseMatchedBtn_Click" Margin="8,0,0,0"
                            Padding="10,3" FontSize="11" Content="⏸ Pause these blocks — traffic resumes"
                            ToolTip="Disables exactly the matched rules. Fully reversible — nothing is deleted."/>
                </StackPanel>
                <ListBox x:Name="MatchList" MaxHeight="150" Margin="0,6,0,0" FontFamily="Consolas" FontSize="10"
                         Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         ToolTip="Sorted by freshest connection attempt — the block still swallowing traffic is the likely culprit."/>
            </StackPanel>
        </Border>

        <!-- Grouped block list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,6" Padding="0,0,0,6">
                            <Expander IsExpanded="{Binding Expanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ImpactGlyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       ToolTip="{Binding ImpactToolTip}"/>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ServiceKey}" FontSize="10" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Summary}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <!-- Group state at a glance: proportional active/paused bar +
             commands labeled with the count they will actually change. -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="90" Height="8" CornerRadius="3" ClipToBounds="True"
                                                    Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" ToolTip="{Binding StateToolTip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding ActiveStar}"/>
                                                        <ColumnDefinition Width="{Binding PausedStar}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource AccentGreenBrush}"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource AccentAmberBrush}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding StateText}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="{Binding ResumeLabel}" Click="GroupResume_Click" Tag="{Binding}"
                                                    Padding="8,2" FontSize="10" VerticalAlignment="Center"
                                                    Visibility="{Binding HasPaused, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Re-enables every paused rule in this group (preview first). Fully reversible — nothing is deleted."/>
                                            <Button Content="{Binding PauseLabel}" Click="GroupPause_Click" Tag="{Binding}"
                                                    Padding="8,2" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Disables every active rule in this group — traffic resumes (preview first). Fully reversible."/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="24,4,0,8">
                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" MaxWidth="880"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="190"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                                                  Click="RowSelect_Click" Tag="{Binding}" VerticalAlignment="Center"
                                                                  ToolTip="{Binding SelectionToolTip}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusGlyph}" FontSize="12" VerticalAlignment="Center"
                                                                   ToolTip="{Binding StatusToolTip}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Target}" FontSize="11" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                                   ToolTip="{Binding TargetToolTip}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding ServiceDisplay}" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                                   ToolTip="{Binding ServiceToolTip}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ClassDisplay}" FontSize="10"
                                                                   Foreground="{Binding ClassBrush}" VerticalAlignment="Center"
                                                                   ToolTip="{Binding ClassToolTip}"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding CreatedDisplay}" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                                   ToolTip="{Binding CreatedToolTip}"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding LastTraffic}" FontSize="10"
                                                                   Foreground="{Binding LastTrafficBrush}" VerticalAlignment="Center"
                                                                   ToolTip="{Binding LastTrafficToolTip}"/>
                                                        <TextBlock Grid.Column="7" Text="{Binding Containment}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding ContainmentBrush}" VerticalAlignment="Center"
                                                                   ToolTip="{Binding ContainmentToolTip}"/>
                                                        <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Content="{Binding RowActionLabel}" Click="RowToggle_Click" Tag="{Binding}"
                                                                    Padding="8,2" FontSize="10" Margin="0,0,6,0"
                                                                   />
                                                            <Button Content="Remove" Click="RowRemove_Click" Tag="{Binding}"
                                                                    Padding="8,2" FontSize="10" Foreground="{DynamicResource AccentRedBrush}"
                                                                   />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Post-action toast: the apply WAS the confirmation's preview; this
             says what happened and offers the takeback. Auto-hides. -->
        <Border x:Name="BlockToast" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="#3FBF7F" BorderThickness="1" CornerRadius="6"
                Padding="14,10" Visibility="Collapsed" Panel.ZIndex="5" MaxWidth="560">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BlockToastText" TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                <Button x:Name="BlockToastUndoBtn" Content="↩ Undo" Click="BlockToastUndo_Click" Margin="14,0,0,0"
                        Padding="12,2" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
