<Window x:Class="AutoCommand.Views.BlockBulkPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk block change — preview"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="680"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- brighter muted gray than the app-wide TextSecondaryBrush - this
             sheet's secondary lines are small and dense -->
        <SolidColorBrush x:Key="MutedBrush" Color="#B9C3D2"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="SubText" Grid.Row="1" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <!-- Checked handlers are wired in code after InitializeComponent:
                 parsing IsChecked="True" would fire Checked while later
                 elements (RbExcept) are still null. -->
            <RadioButton x:Name="RbAll" GroupName="scope" IsChecked="True" FontSize="12" Margin="0,0,0,4"/>
            <RadioButton x:Name="RbExcept" GroupName="scope" FontSize="12" Margin="0,0,0,6"/>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" Margin="0,0,0,10" MaxHeight="260">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GroupsLv"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Click="CancelBtn_Click"
                    Padding="14,4" FontSize="12" Margin="0,0,8,0"/>
            <Button x:Name="ApplyBtn" Click="ApplyBtn_Click" Padding="14,4" FontSize="12"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
