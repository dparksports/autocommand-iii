<UserControl x:Class="AutoCommand.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="UpdateMutedBrush" Color="#B9C3D2"/>
    </UserControl.Resources>

    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🪟 Windows Update" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Security patches can't reach a machine this locked down. When you feel the need to update, do it here — AutoCommand lifts exactly the blocks the update needs, puts every one of them back when it finishes, and proves it."
                           FontSize="11" Foreground="{StaticResource UpdateMutedBrush}" Margin="0,2,0,0" MaxWidth="720" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <!-- ══ READY ══ -->
                <StackPanel x:Name="ReadyPanel">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ReadyHeadline" FontSize="13" FontWeight="SemiBold" Text="✓ Ready when you are"/>
                            <TextBlock x:Name="ReadyDetail" FontSize="12" Foreground="{StaticResource UpdateMutedBrush}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="How this works" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource UpdateMutedBrush}" TextWrapping="Wrap"
                                       LineHeight="18"
                                       Text="1.  AutoCommand lists exactly which blocks the update needs — and which stay on. You see the list before anything changes.&#10;2.  You press Update now. Only those blocks lift, with a hard stop 2 hours later even if something goes wrong. The update runs and installs normally.&#10;3.  When it finishes, every lifted block comes back and AutoCommand verifies it against the live firewall. You get proof, not promises — and the whole session appears in the Audit tab."/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="What's currently in the way" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" FontWeight="SemiBold" Text="Windows Update &amp; Store downloads"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="{StaticResource UpdateMutedBrush}" x:Name="PathwayCount" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Foreground="{StaticResource UpdateMutedBrush}" Margin="0,1,0,6"
                                           Text="wuauserv · dosvc · usosvc · bits — the services that scan, download and install updates."/>
                                <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" FontWeight="SemiBold" Text="Defender protection"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="{StaticResource UpdateMutedBrush}" x:Name="DefenderCount" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" FontSize="11" Foreground="{StaticResource UpdateMutedBrush}" Margin="0,1,0,6"
                                           Text="MsMpEng.exe · MpCmdRun.exe — signature updates are security patches; included by default."/>
                            </Grid>
                            <TextBlock FontSize="11" Foreground="{StaticResource UpdateMutedBrush}" TextWrapping="Wrap"
                                       x:Name="ReserveLine" Margin="0,2,0,2"/>
                            <TextBlock FontSize="11" Foreground="#34D399" TextWrapping="Wrap" x:Name="StayingLine" Margin="0,2,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CheckBtn" Content="Check for updates first" Click="CheckBtn_Click"
                                        Padding="10,5" FontSize="11" Margin="0,0,8,0"
                                        ToolTip="Asks Windows what it would install — lifts nothing."/>
                                <Button x:Name="StartBtn" Content="Update now" Click="StartBtn_Click"
                                        Padding="14,5" FontSize="11" FontWeight="SemiBold"
                                        Background="{DynamicResource AccentBlueBrush}" Foreground="White"
                                        ToolTip="Lift exactly the listed blocks, run the update, put everything back and verify."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="NightlyCheck" VerticalAlignment="Top" Margin="0,1,10,0"
                                      Checked="NightlyCheck_Changed" Unchecked="NightlyCheck_Changed"
                                      ToolTip="A standing 20-minute nightly window (3:00–3:20 AM) for Defender signature updates only — same gates, scheduled while the app runs."/>
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Let Defender update itself nightly · 3:00 – 3:20 AM"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource UpdateMutedBrush}" TextWrapping="Wrap"
                                           Text="A standing 20-minute window for signature updates only — the same gates, scheduled. Windows Update itself still waits for you. Runs while AutoCommand is running."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══ ACTIVE ══ -->
                <StackPanel x:Name="ActivePanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentAmberBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ActiveHeadline" FontSize="14" FontWeight="SemiBold" Text="Updating…"/>
                            <TextBlock x:Name="ActiveNote" FontSize="12" Foreground="{StaticResource UpdateMutedBrush}"
                                       Margin="0,4,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PhaseList" FontSize="12" Foreground="{StaticResource UpdateMutedBrush}"
                                       LineHeight="20" TextWrapping="Wrap"/>
                            <TextBlock x:Name="Countdown" FontSize="12" Foreground="{DynamicResource AccentAmberBrush}" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="WidenBtn" Content="Download stalled? Open update CDNs" Click="WidenBtn_Click"
                                        Padding="10,4" FontSize="11" Margin="0,0,10,0"
                                        ToolTip="Escalation tier: opens the Akamai/Gcore CDN-edge blocks the update content comes from. They go back with everything else."/>
                                <Button Content="Restore all blocks now" Click="RestoreNow_Click"
                                        Padding="10,4" FontSize="11"
                                        ToolTip="Closes the session early. An install already applied stays applied; only a later download could stall."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="What happens the moment it finishes: all lifted blocks re-apply and get checked against the live firewall, Defender's blocks follow its new version folder, lingering connections are severed — every step reported below."
                               FontSize="11" Foreground="{StaticResource UpdateMutedBrush}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                </StackPanel>

                <!-- ══ AFTER ══ -->
                <StackPanel x:Name="AfterPanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="#4034D399"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="AfterHeadline" FontSize="13" FontWeight="SemiBold" Text="✓ Done — everything is blocked again"/>
                            <TextBlock x:Name="AfterSummary" FontSize="12" Foreground="{StaticResource UpdateMutedBrush}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="What AutoCommand did after the update" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="Checklist">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource UpdateMutedBrush}"
                                                   Margin="0,2,0,2" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border x:Name="RestartCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="#66FBBF24"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Restart pending" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentAmberBrush}"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource UpdateMutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"
                                       Text="The update finishes installing at the restart. Your blocks stay on across it — firewall rules survive reboots; nothing re-opens."/>
                            <Button Content="Restart now" Click="RestartNow_Click" Padding="10,4" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <Button Content="← Back" Click="Back_Click" Padding="10,4" FontSize="11"
                            HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- ══ HISTORY ══ -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,10">
                    <StackPanel>
                        <TextBlock Text="Previous update sessions" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource UpdateMutedBrush}" Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
