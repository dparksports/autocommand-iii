<Window x:Class="AutoCommand.Views.BlockedRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blocked Rules — manage all AutoCommand firewall blocks" Width="980" Height="640" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Blocked Rules" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Every block AutoCommand created — grouped by destination owner. Red groups are Microsoft infrastructure or Windows components: blocking them usually breaks updates, notifications or DNS, not threats."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,-8,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="RefreshBtn_Click" Margin="0,0,8,0"/>
            <Button Content="✕ Unblock selected" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="UnblockSelectedBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="UnblockMsBtn" Content="✕ Unblock Microsoft-owned ⚠" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="UnblockMsBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="ConsolidateBtn" Content="🧹 Consolidate legacy (4→2 rules)" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="ConsolidateBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="DedupBtn" Content="🧹 Clean duplicates" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="DedupBtn_Click" Margin="0,0,8,0"
                    ToolTip="Retires exact-duplicate rules (same name, same target) — inert residue of concurrent blocking. One rule per identity is kept with its provenance; blocking is unchanged and continuous. Legacy 4→2 mixes are the Consolidate button's job."/>
            <Button Content="⬇ Export CSV" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="ExportBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="ReenableBtn" Content="↩ Re-enable all (undo panic)" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="ReenableBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="RestoreExceptRiskyBtn" Content="↩ Restore except Microsoft/Windows ⚠" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="RestoreExceptRiskyBtn_Click" Margin="0,0,8,0"
                    ToolTip="Re-enables every block EXCEPT Microsoft/CDN and Windows-component targets — the ones that break internet, updates or notifications. Those stay disabled (red rows) until you decide."/>
            <Button x:Name="EnableLogBtn" Content="📋 Enable drop-logging (extra hit source)" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="EnableLogBtn_Click" Margin="0,0,8,0"
                    ToolTip="Turns on 'Log dropped packets' for all firewall profiles (4 MB cap, default file). The live feed below already works without it — this adds the firewall's own per-packet log as a second source."/>
            <Button x:Name="RdapBtn" Content="🌐 RDAP-verify unclassified" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="RdapBtn_Click" Margin="0,0,8,0"
                    ToolTip="Asks the registries who owns each unclassified target. Results are cached machine-wide (C:\ProgramData\AutoCommand\rdap-cache.json) — repeat runs are instant and offline-capable."/>
        </WrapPanel>

        <DataGrid Grid.Row="2" x:Name="RulesGrid" SelectionMode="Extended" IsReadOnly="True"
                  FontFamily="Consolas" FontSize="11" AutoGenerateColumns="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRisky}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BadgeRedBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Target"    Binding="{Binding Target}"   Width="170"/>
                <DataGridTextColumn Header="Kind"      Binding="{Binding Kind}"     Width="46"/>
                <DataGridTextColumn Header="Owner / class" Binding="{Binding Class}" Width="150"/>
                <DataGridTextColumn Header="Rules"     Binding="{Binding RulesSummary}" Width="90"/>
                <DataGridTextColumn Header="Dups"      Binding="{Binding DupsDisplay}"  Width="46"/>
                <DataGridTextColumn Header="Blocked"   Binding="{Binding CreatedDisplay}" Width="120"/>
                <DataGridTextColumn Header="Hits 1h"   Binding="{Binding HitsDisplay}"   Width="70"/>
                <DataGridTextColumn Header="RDAP owner" Binding="{Binding OwnerDisplay}" Width="170"/>
                <DataGridTextColumn Header="Provenance (also in wf.msc → rule Properties)" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent"
                      ToolTip="Drag to resize the two panels"/>

        <TextBlock Grid.Row="4" Margin="0,8,0,4" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Recently blocked connects — live (Sysmon EID 3 joined against this list: who is being blocked, right now)"/>

        <DataGrid Grid.Row="5" x:Name="HitsGrid" IsReadOnly="True"
                  FontFamily="Consolas" FontSize="11" AutoGenerateColumns="False"
                  ToolTip="Windows Firewall blocks connect silently at the kernel — this feed synthesizes the missing signal by joining Sysmon connect attempts against the blocked targets above. Needs Sysmon installed; history persists across restarts.">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process"    Binding="{Binding Process}"    Width="170"/>
                <DataGridTextColumn Header="PID"        Binding="{Binding Pid}"        Width="60"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="150"/>
                <DataGridTextColumn Header="Match"      Binding="{Binding Match}"      Width="70"/>
                <DataGridTextColumn Header="Attempts"   Binding="{Binding Attempts}"   Width="70"/>
                <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen}"  Width="130"/>
                <DataGridTextColumn Header="Last seen"  Binding="{Binding LastSeen}"   Width="130"/>
                <DataGridTextColumn Header="Image"      Binding="{Binding Image}"      Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="6" x:Name="StatusText" Text="Loading…"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
