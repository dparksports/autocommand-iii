<UserControl x:Class="AutoCommand.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Settings" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Configure Auto-Command preferences and startup behavior." 
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Unblock (SmartScreen / Smart App Control) -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Unblock (SmartScreen / Smart App Control)" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button x:Name="UnblockAppBtn" Content="🔓 Unblock this app's files" Style="{StaticResource PrimaryButton}"
                                    Click="UnblockAppBtn_Click" Margin="0,0,8,0"/>
                            <Button x:Name="UnblockFolderBtn" Content="📂 Unblock another folder…" Style="{StaticResource PrimaryButton}"
                                    Click="UnblockFolderBtn_Click" Margin="0,0,12,0"/>
                            <TextBlock x:Name="UnblockStatusText" Text="" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Windows marks every file extracted from a downloaded zip with the 'Mark-of-the-Web' — on Smart App Control machines that mark is what produces 'blocked: dangerous file from the web'. This removes the mark from this app's folder (or any folder you pick, e.g. a fresh zip extraction) so unsigned AutoCommand launches normally. Files are never modified — only the download marker is deleted. A standalone script (unblock-autocommand.ps1, on the Releases page) does the same without running the app."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Appearance -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <TextBlock Text="Theme:" Foreground="{DynamicResource TextSecondaryBrush}" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeCombo" Width="200" SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="🌙 Dark (default)" Tag="Dark"/>
                                <ComboBoxItem Content="☀️ Light" Tag="Light"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Dark = deep slate with the Fluent blue accent. Light = airy white-card Fluent theme. Applies instantly across every tab and is remembered for next launch."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Startup Behavior -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Startup Behavior" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <CheckBox x:Name="LaunchOnStartupCheck" 
                                      Content="Launch when user logs in" 
                                      Checked="LaunchOnStartupCheck_Checked"
                                      Unchecked="LaunchOnStartupCheck_Unchecked"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Row="2" Text="This creates a Scheduled Task to run Auto-Command with highest privileges upon user login, bypassing the UAC prompt."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Network Adapter Security -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Network Adapter Security" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <CheckBox x:Name="AutoMitigateAdaptersCheck" 
                                      Content="Automatically delete active SSTP and Kernel Debug adapters" 
                                      Checked="AutoMitigateAdaptersCheck_Checked"
                                      Unchecked="AutoMitigateAdaptersCheck_Unchecked"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Row="2" Text="If disabled, you will be notified when an unauthorized adapter becomes active and given the option to block it."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Instrumentation -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Instrumentation" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Every periodic background instrument, with its cadence under your control. Instruments are phase-spread so equal-cadence work never piles onto the same instant; heavy ones are serialized a second apart; and a run that takes too long on this machine auto-slows its instrument (noted in amber) until you recalibrate it here. Changes apply immediately and persist across restarts."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,10"/>

                        <ItemsControl x:Name="InstrumentsList"/>

                        <TextBlock Text="Managed disk writes" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        <TextBlock x:Name="DiskStatsText" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox x:Name="ThriftyDiskChk" FontSize="11"
                                      Content="Minimize disk writes — flush every 5 minutes, 1 MB buffers"
                                      Checked="ThriftyDisk_Changed" Unchecked="ThriftyDisk_Changed"
                                      ToolTip="Batching for HDD-friendliness and idle machines: the flush instrument's cadence moves to 5 minutes and buffers grow to 1 MB (a buffer still self-flushes at its threshold). The trade-off is a larger crash window - one flush interval - which every routed writer tolerates by design."/>
                            <Button x:Name="FlushDiskBtn" Content="Flush now" Click="FlushDiskBtn_Click"
                                    Padding="10,3" FontSize="11" Margin="12,0,0,0"
                                    ToolTip="Write every buffered journal line and pending store rewrite immediately."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ResetInstrumentsBtn" Content="↺ Restore defaults" Click="ResetInstrumentsBtn_Click"
                                    Padding="10,3" FontSize="11"
                                    ToolTip="Every instrument returns to its default cadence and on/off state."/>
                            <Button x:Name="RefreshInstrumentsBtn" Content="⟳ Refresh stats" Click="RefreshInstrumentsBtn_Click"
                                    Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                    ToolTip="Re-read each instrument's live run stats."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Application Information -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Application Information" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Version:" Foreground="{DynamicResource TextSecondaryBrush}" Width="150" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionValueText" Text="…" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Footnote -->
                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <TextBlock Text="Made with ❤️ in California"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="Apache License 2.0" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="© 2026 Dan Park, magicpoint.ai" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Community: the live anonymous count + share -->
                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <WrapPanel>
                                <Button x:Name="CommunityGraphBtn" Content="📈 Community graph" Style="{StaticResource PrimaryButton}"
                                        Click="CommunityGraph_Click" Margin="0,0,8,0"
                                        ToolTip="How many people run AutoCommand — an anonymous opt-in daily count, charted live. Opens the public page in your browser."/>
                                <Button x:Name="ShareBtn" Content="🔗 Share AutoCommand" Style="{StaticResource PrimaryButton}"
                                        Click="Share_Click"
                                        ToolTip="Copy the download link and pass it to a peer who needs to see what their PC is really doing."/>
                            </WrapPanel>
                            <TextBlock x:Name="ShareStatusText" Margin="0,8,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Text=""/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>