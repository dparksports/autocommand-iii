<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test for the F# bridge engine (Engines.Bridge) — the transport
       and session layer the AI-access tools ride on. Everything synthetic:
       a custom AppIdentity (temp data root, port base 47931 — far from the
       production 47821 scan range) and stub tools, so the suite never
       touches the live agent dir, the user's session.json, or the running
       app's listener. Drives the raw wire protocol the way the deployed
       AgentProxy and hand-rolled clients do: one request per connection,
       hand-built HTTP/1.1 bytes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BridgeSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engines\Engines.Bridge\Engines.Bridge.fsproj" />
  </ItemGroup>
</Project>
