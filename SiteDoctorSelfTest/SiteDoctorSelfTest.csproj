<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test for the "Why is this site slow?" pipeline. Phase 5 of the
       AutoCommand II extraction (REWRITE.md): the engines live in
       core\AutoCommand.Sitedoctor.Core (fingerprint/verdict/dependency)
       with TransmissionRecord from the Intercept core — this harness
       references the library and runs the shipped assemblies.

       Offline sections drive the fingerprint engine with synthetic archive
       records and the verdict rules with synthetic probe reports. The one
       LIVE section binds loopback listeners (no admin, no external network):
       a TLS server that answers handshakes, and a "black hole" that accepts
       TCP and never replies — the exact failure shape the dual-hello probe
       exists to detect, proven detectable at the source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SiteDoctorSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engines\Engines.Watch\Engines.Watch.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\AutoCommand.Sitedoctor.Core\AutoCommand.Sitedoctor.Core.csproj" />
    <ProjectReference Include="..\Engines\Engines.Diagnosis\Engines.Diagnosis.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AutoCommand.Engines.Diagnosis" />
    <Using Include="AutoCommand.Engines.Core" />
    <Using Include="SiteVerdictService = AutoCommand.Engines.Diagnosis.SiteVerdict" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="AutoCommand.Engines.Watch" />
  </ItemGroup>
</Project>
