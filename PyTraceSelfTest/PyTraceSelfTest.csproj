<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline self-test for the Python Spawns tab's non-UI engine. Compiles
       the WPF-free services from the app project directly, so what runs here
       is byte-identical to what ships in AutoCommand. Excluded from the app
       build (AutoCommand.csproj Compile Remove, like ScratchTest): it has its
       own Main() and would double-define the linked service classes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PyTraceSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engines\Engines.Watch\Engines.Watch.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything now from the Forensics core library (phase 4
         extraction, REWRITE.md): the PyTrace pair, MotwUnblocker, and
         PyTraceRecord — plus the stream capture/TLS engines it exercises
         via the Intercept core. No source copies remain here. -->
    <ProjectReference Include="..\core\AutoCommand.Forensics.Core\AutoCommand.Forensics.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AutoCommand.Engines.Watch" />
  </ItemGroup>
</Project>
