<Window x:Class="AutoCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoCommand.Views"
        x:Name="RootWindow"
        Title="Auto-Command" Height="750" Width="1200"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Pane collapse (the hamburger): nav labels and group headers hide
             so the sidebar narrows to its icons — Shields Up's collapsed
             NavigationView. Bound to RootWindow.IsPaneCollapsed, toggled by
             the burger item at the top of the strip. -->
        <Style x:Key="NavPaneLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaneCollapsed, ElementName=RootWindow}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavGroupLabel" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaneCollapsed, ElementName=RootWindow}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content. The sidebar is grouped: WATCH (feeds that show what
             the machine is doing), CONTAIN (blocking & defenses), SYSTEM
             (everything configurational). Group headers are non-selectable
             TabItems; entries are single-line so all 16 fit without
             scrolling. The burger item at the very top is a fake tab: its
             selection is intercepted in code-behind to toggle the pane
             collapse instead of navigating. SelectedIndex=2 skips the burger
             and the WATCH header explicitly. -->
        <TabControl x:Name="MainTabControl" Grid.Row="0" TabStripPlacement="Left" SelectedIndex="2"
                    SelectionChanged="MainTabControl_SelectionChanged">

            <!-- hamburger: collapses the sidebar to icons-only and back -->
            <TabItem x:Name="NavPaneToggleItem" ToolTip="Show / hide menu labels">
                <TabItem.Header>
                    <TextBlock Text="☰" FontSize="16" FontWeight="Bold" Margin="4,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </TabItem.Header>
            </TabItem>

            <!-- ═══ WATCH ═══ -->
            <TabItem x:Name="WatchHeaderItem" IsEnabled="False" Focusable="False">
                <TabItem.Header>
                    <TextBlock x:Name="WatchHeaderText" Text="WATCH" FontSize="10" FontWeight="Bold"
                               Style="{StaticResource NavGroupLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,2"
                               ToolTip="Feeds that show what this machine is running and where it connects."/>
                </TabItem.Header>
            </TabItem>
            <TabItem x:Name="ProcessMonitorNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Process Monitor" Style="{StaticResource NavPaneLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <!-- The rain is the monitor's right panel, not its own tab:
                     the same live table, one glance apart. The thin rail
                     between them folds EITHER pane — ‹ hides the list
                     (rain only), › hides the rain (list only); a chevron
                     disables when pressing it would empty the tab. State
                     persists across launches. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListColumn" Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition x:Name="RainColumn" Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <views:SvchostMonitorView x:Name="SvchostTab" Grid.Column="0"/>
                    <Border x:Name="RainRail" Grid.Column="1" Width="18"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="ListToggleBtn" Grid.Row="0" Focusable="False" Click="ListToggleBtn_Click"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip="Hide the process list — rain only">
                                <TextBlock Text="‹" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            </Button>
                            <Button x:Name="RainToggleBtn" Grid.Row="1" Focusable="False" Click="RainToggleBtn_Click"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip="Hide the Matrix rain">
                                <TextBlock Text="›" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </Button>
                        </Grid>
                    </Border>
                    <views:MatrixRainView x:Name="MatrixRainTab" Grid.Column="2"/>
                </Grid>
            </TabItem>

            <!-- ═══ CONTAIN ═══ -->
            <TabItem IsEnabled="False" Focusable="False">
                <TabItem.Header>
                    <TextBlock Text="CONTAIN" FontSize="10" FontWeight="Bold"
                               Style="{StaticResource NavGroupLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,10,0,2"
                               ToolTip="Blocking, sinkholing and defenses — actions that stop things."/>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Firewall" Style="{StaticResource NavPaneLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:FirewallSettingsView x:Name="FirewallTab"/>
            </TabItem>
            <TabItem x:Name="BlocksNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⛔" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Blocks" Style="{StaticResource NavPaneLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BlocksView x:Name="BlocksTab"/>
            </TabItem>
            <TabItem x:Name="AuditNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Audit" Style="{StaticResource NavPaneLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:AuditView x:Name="AuditTab"/>
            </TabItem>

            <!-- ═══ SYSTEM ═══ -->
            <TabItem x:Name="SystemHeaderItem" IsEnabled="False" Focusable="False">
                <TabItem.Header>
                    <TextBlock x:Name="SystemHeaderText" Text="SYSTEM" FontSize="10" FontWeight="Bold"
                               Style="{StaticResource NavGroupLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,10,0,2"
                               ToolTip="AI access, privacy, Windows telemetry, Sysmon health and app settings."/>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Be My Guest" Style="{StaticResource NavPaneLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BeMyGuestView x:Name="BeMyGuestTab"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Settings" Style="{StaticResource NavPaneLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
            <TabItem x:Name="UpdateNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🪟" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Windows Update" Style="{StaticResource NavPaneLabel}" VerticalAlignment="Center"
                                   ToolTip="The sanctioned way to update: lift exactly the update-pathway blocks, run the update, put everything back and verify."/>
                    </StackPanel>
                </TabItem.Header>
                <views:UpdateView x:Name="UpdateTab"/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Enforcer Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="EnforcerDot" Width="8" Height="8" Fill="{DynamicResource AccentCyanBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EnforcerStatusText" Text="Security Enforcer: Active" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Threat Alert -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="ThreatAlertText" Text=""
                               Foreground="{DynamicResource AccentAmberBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="ReviewAlertBtn" Content="Review"
                            Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="ReviewAlertBtn_Click"/>
                    <Button x:Name="RestoreInternetBtn" Content="🚑 Restore Internet"
                            Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0"
                            ToolTip="Blocked something and lost connectivity? Disables ALL AutoCommand-created firewall block rules at once. Fully reversible — nothing is deleted."
                            Click="RestoreInternetBtn_Click"/>
                </StackPanel>

                <!-- Version -->
                <TextBlock x:Name="VersionText" Grid.Column="2" Text="AutoCommand"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
