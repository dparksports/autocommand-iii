<Window x:Class="AutoCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoCommand.Views"
        Title="Auto-Command" Height="750" Width="1200"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content. The sidebar is grouped: WATCH (feeds that show what
             the machine is doing), CONTAIN (blocking & defenses), SYSTEM
             (everything configurational). Group headers are non-selectable
             TabItems; entries are single-line so all 15 fit without
             scrolling. SelectedIndex=1 skips the WATCH header explicitly. -->
        <TabControl x:Name="MainTabControl" Grid.Row="0" TabStripPlacement="Left" SelectedIndex="1">

            <!-- ═══ WATCH ═══ -->
            <TabItem x:Name="WatchHeaderItem" IsEnabled="False" Focusable="False">
                <TabItem.Header>
                    <TextBlock x:Name="WatchHeaderText" Text="WATCH" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,2"
                               ToolTip="Feeds that show what this machine is running and where it connects."/>
                </TabItem.Header>
            </TabItem>
            <TabItem x:Name="ProcessMonitorNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Process Monitor" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SvchostMonitorView x:Name="SvchostTab"/>
            </TabItem>
            <TabItem x:Name="MatrixRainNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌧" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Rain" VerticalAlignment="Center" ToolTip="The process monitor as Matrix rain — same live data, for those who'd rather watch it."/>
                    </StackPanel>
                </TabItem.Header>
                <views:MatrixRainView x:Name="MatrixRainTab"/>
            </TabItem>

            <!-- ═══ CONTAIN ═══ -->
            <TabItem IsEnabled="False" Focusable="False">
                <TabItem.Header>
                    <TextBlock Text="CONTAIN" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,10,0,2"
                               ToolTip="Blocking, sinkholing and defenses — actions that stop things."/>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Firewall" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:FirewallSettingsView x:Name="FirewallTab"/>
            </TabItem>
            <TabItem x:Name="BlocksNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⛔" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Blocks" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BlocksView x:Name="BlocksTab"/>
            </TabItem>
            <TabItem x:Name="AuditNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Audit" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:AuditView x:Name="AuditTab"/>
            </TabItem>

            <!-- ═══ SYSTEM ═══ -->
            <TabItem x:Name="SystemHeaderItem" IsEnabled="False" Focusable="False">
                <TabItem.Header>
                    <TextBlock x:Name="SystemHeaderText" Text="SYSTEM" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,10,0,2"
                               ToolTip="AI access, privacy, Windows telemetry, Sysmon health and app settings."/>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Be My Guest" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BeMyGuestView x:Name="BeMyGuestTab"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Enforcer Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="EnforcerDot" Width="8" Height="8" Fill="#00E5FF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EnforcerStatusText" Text="Security Enforcer: Active" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Threat Alert -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="ThreatAlertText" Text=""
                               Foreground="#E5A631" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="ReviewAlertBtn" Content="Review"
                            Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="ReviewAlertBtn_Click"/>
                    <Button x:Name="RestoreInternetBtn" Content="🚑 Restore Internet"
                            Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0"
                            ToolTip="Blocked something and lost connectivity? Disables ALL AutoCommand-created firewall block rules at once. Fully reversible — nothing is deleted."
                            Click="RestoreInternetBtn_Click"/>
                </StackPanel>

                <!-- Version -->
                <TextBlock x:Name="VersionText" Grid.Column="2" Text="AutoCommand"
                           Foreground="#5A5A62" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
