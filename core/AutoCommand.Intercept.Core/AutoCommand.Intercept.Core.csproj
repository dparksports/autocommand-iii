<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Intercept core: everything that captures, decodes, and archives
       what programs actually put on the wire — the raw-socket sniffer and
       TCP stream capture, the TLS keylog/decrypt/SNI family, the loopback
       proxy + CA + system hooks, the Sysmon connect watcher that feeds it,
       and the transmissions pipeline/archive that turns captured flows
       into recorded facts (plus the traffic aggregation that bills them).
       Extracted from the WPF exe in AutoCommand II phase 2 (REWRITE.md) —
       namespaces deliberately unchanged, so every consumer (views,
       PyTraceSelfTest, SiteDoctorSelfTest) compiles against the library
       without edits and runs the shipped assembly.

       SysmonConnectWatcherService lives HERE rather than in NetWatch.Core:
       its phase-1 "Forensics/Intercept dependencies" turned out to be
       comments only, and its only real consumer is the transmissions
       pipeline in this cluster. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>AutoCommand.Intercept.Core</AssemblyName>
    <RootNamespace>AutoCommand.Intercept.Core</RootNamespace>
    <Company>AutoCommand</Company>
    <Product>AutoCommand.Intercept.Core</Product>
    <Description>Intercept engines behind AutoCommand: raw-socket sniffer, TCP stream capture, TLS keylog/decrypt/SNI, loopback proxy with CA and system hooks, Sysmon connect watcher, and the transmissions pipeline/archive with traffic aggregation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Engines\Engines.Watch\Engines.Watch.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SvchostMonitorItem (the monitor row) lives in the NetWatch core -->
    <ProjectReference Include="..\AutoCommand.NetWatch.Core\AutoCommand.NetWatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SysmonConnectWatcherService reads the live Sysmon channel
         (EventLogReader/EventLogWatcher) — same package the NetWatch core
         and OneSettingsCadence.Core pin for event-channel work. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Engines\Engines.Core\Engines.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="IpClassifier = AutoCommand.Engines.Core.IpClassification" />

  </ItemGroup>
  <ItemGroup>
    <Using Include="AutoCommand.Engines.Watch" />
  </ItemGroup>
</Project>
