<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SvchostAnalyzer.Core</AssemblyName>
    <RootNamespace>SvchostAnalyzer.Core</RootNamespace>
    <Description>svchost network-trace capture engine and pattern analyzer — the engine behind the SvchostAnalyzer CLI and the AutoCommand Svchost Trace tab. JSONL schema is shared by all of them.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

</Project>
