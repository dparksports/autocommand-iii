<Project>
  <!-- NU1900 ("error occurred while getting package vulnerability data")
       fires on every restore when this normally-offline machine cannot
       reach api.nuget.org. It is a connectivity notice, not a finding:
       actual vulnerability verdicts (NU1901-NU1903) still surface
       whenever the audit service is reachable. Suppressed centrally here
       so local and CI builds stay warning-clean offline. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>
</Project>
